{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-normal",
      "type": "shell",
      "command": "${workspaceRoot}\\qawno\\pawncc.exe",
      "runOptions": {
        "instanceLimit": 1
      },
      "args": [
        "${workspaceRoot}\\gamemodes\\dustrpg.pwn",
        "-Dgamemodes",
        "'-;+'",
        "'-(+'"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "pawn",
        "fileLocation": ["relative", "${workspaceRoot}"],
        "pattern": {
          "regexp": "^(.*?)\\(([0-9]*)[- 0-9]*\\) \\: (fatal error|error|warning) [0-9]*\\: (.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "message": 4
        }
      }
    },
    {
      "label": "build-phone",
      "type": "shell",
      "command": "${workspaceRoot}\\qawno\\pawncc.exe",
      "runOptions": {
        "instanceLimit": 1
      },
      "args": [
        "${workspaceRoot}\\filterscripts\\Phone\\phone.pwn",
        "-Dfilterscripts\\Phone",
        "'-;+'",
        "'-(+'"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "pawn",
        "fileLocation": ["relative", "${workspaceRoot}"],
        "pattern": {
          "regexp": "^(.*?)\\(([0-9]*)[- 0-9]*\\) \\: (fatal error|error|warning) [0-9]*\\: (.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "message": 4
        }
      }
    }
  ]
}
